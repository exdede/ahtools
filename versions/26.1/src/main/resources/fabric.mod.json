{
  "schemaVersion": 1,
  "id": "ahtools",
  "version": "${version}",
  "name": "AHTools",
  "description": "Auction house tools for DonutSMP: hotbar seller, sales tracker, profit HUD, command spammer. Automation can get you banned, use at your own risk.",
  "authors": [
    "exdede"
  ],
  "contact": {
    "sources": "https://github.com/exdede/ahtools",
    "issues": "https://github.com/exdede/ahtools/issues"
  },
  "license": "MIT",
  "icon": "assets/ahtools/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.exdede.ahtools.AhToolsMod"
    ],
    "modmenu": [
      "dev.exdede.ahtools.compat.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": "~26.1",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*"
  }
}
